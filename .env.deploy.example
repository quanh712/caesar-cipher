# Copy to .env.deploy on the deployment host. Never deploy a moving branch.
APP_DOMAIN=cipher.example.com
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080

# FE and BE repositories are sibling directories by default.
BACKEND_CONTEXT=../caesar-cipher-be

FRONTEND_REVISION=replace-with-frontend-commit-sha
BACKEND_REVISION=9b5cfb2bf75550a8c9295b06e2d0b8dc9e825be4
FRONTEND_IMAGE_TAG=local
BACKEND_IMAGE_TAG=9b5cfb2

FRONTEND_CPUS=0.5
FRONTEND_MEMORY=128m
BACKEND_CPUS=1.0
BACKEND_MEMORY=512m
